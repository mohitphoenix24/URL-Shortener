{
  "title": "URL Shortener",
  "uid": "url-shortener-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "tags": ["url-shortener"],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "HTTP",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request rate by route",
      "description": "sum(rate(url_shortener_http_request_duration_seconds_count[5m])) by (route)",
      "gridPos": { "x": 0, "y": 1, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(url_shortener_http_request_duration_seconds_count[5m])) by (route)",
          "legendFormat": "{{route}}",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p95 latency by route",
      "description": "histogram_quantile(0.95, sum(rate(url_shortener_http_request_duration_seconds_bucket[5m])) by (le, route))",
      "gridPos": { "x": 12, "y": 1, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(url_shortener_http_request_duration_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "{{route}}",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Error rate (5xx)",
      "description": "sum(rate(...{status_code=~\"5..\"}[5m])) / sum(rate(...[5m]))",
      "gridPos": { "x": 0, "y": 9, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(url_shortener_http_request_duration_seconds_count{status_code=~\"5..\"}[5m])) / sum(rate(url_shortener_http_request_duration_seconds_count[5m]))",
          "legendFormat": "5xx rate",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Cache hit ratio",
      "description": "sum(rate(url_shortener_cache_operations_total{result=\"hit\"}[5m])) / sum(rate(url_shortener_cache_operations_total[5m]))",
      "gridPos": { "x": 6, "y": 9, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.5 },
              { "color": "green", "value": 0.8 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(url_shortener_cache_operations_total{result=\"hit\"}[5m])) / sum(rate(url_shortener_cache_operations_total[5m]))",
          "legendFormat": "hit ratio",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Rate limit rejections by tier",
      "description": "sum(rate(url_shortener_rate_limit_rejections_total[5m])) by (tier) — the anon tier is expected to show rejections; that's the login brute-force protection working (see docs/decisions.md)",
      "gridPos": { "x": 12, "y": 9, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(url_shortener_rate_limit_rejections_total[5m])) by (tier)",
          "legendFormat": "{{tier}}",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 7,
      "type": "row",
      "title": "Redirect cache & click analytics",
      "gridPos": { "x": 0, "y": 15, "w": 24, "h": 1 }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Cache operations by result",
      "description": "sum(rate(url_shortener_cache_operations_total[5m])) by (result) — hit | negative_hit | miss | error",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(url_shortener_cache_operations_total[5m])) by (result)",
          "legendFormat": "{{result}}",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Click capture outcomes",
      "description": "sum(rate(url_shortener_clicks_recorded_total[5m])) by (status) — 'error' here would otherwise only be visible in logs (recordClick swallows its own errors so a redirect never fails because of it)",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(url_shortener_clicks_recorded_total[5m])) by (status)",
          "legendFormat": "{{status}}",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Process",
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 1 }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Resident memory",
      "description": "url_shortener_process_resident_memory_bytes",
      "gridPos": { "x": 0, "y": 25, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "expr": "url_shortener_process_resident_memory_bytes",
          "legendFormat": "RSS",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Event loop lag (p99)",
      "description": "url_shortener_nodejs_eventloop_lag_p99_seconds — sustained growth here means the process is doing too much synchronous work per tick",
      "gridPos": { "x": 12, "y": 25, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "url_shortener_nodejs_eventloop_lag_p99_seconds",
          "legendFormat": "p99 lag",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    }
  ]
}
