# Copy this file to .env and fill in real values. .env is gitignored.

# --- App ---
NODE_ENV=development
PORT=4500
LOG_LEVEL=debug
APP_BASE_URL=http://localhost:4500

# --- Postgres ---
# Matches docker-compose.yml (host port 5435 to avoid clashing with other local Postgres instances)
DATABASE_URL=postgresql://url_shortener:url_shortener_dev_pw@localhost:5435/url_shortener

# --- Redis ---
# Matches docker-compose.yml (host port 6381)
REDIS_URL=redis://localhost:6381

# --- Auth ---
# Generate strong random secrets, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- CORS ---
CORS_ORIGIN=http://localhost:5175

# --- Rate limiting ---
RATE_LIMIT_ANON_CAPACITY=20
RATE_LIMIT_ANON_REFILL_PER_SEC=0.33
RATE_LIMIT_AUTH_CAPACITY=100
RATE_LIMIT_AUTH_REFILL_PER_SEC=1.5
RATE_LIMIT_REDIRECT_CAPACITY=300
RATE_LIMIT_REDIRECT_REFILL_PER_SEC=5

# --- Cache ---
LINK_CACHE_TTL_SECONDS=3600
LINK_NEGATIVE_CACHE_TTL_SECONDS=60

# --- Click analytics ---
# Generate a strong random salt the same way as the JWT secrets above.
IP_HASH_SALT=change-me-ip-hash-salt-min-16-chars
ANALYTICS_DEFAULT_RANGE_DAYS=30
ANALYTICS_MAX_RANGE_DAYS=365
