{
  "name": "url-shortener-backend",
  "version": "0.1.0",
  "description": "Production-grade URL shortener API — PERN + Redis, raw SQL, cache-aside, hand-written rate limiting.",
  "type": "module",
  "main": "src/server.js",
  "author": "Mohit Sharma",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node-pg-migrate",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "seed": "node scripts/seed.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --pool=forks",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "prom-client": "^15.1.3",
    "swagger-ui-express": "^5.0.1",
    "ua-parser-js": "^1.0.40",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testcontainers/postgresql": "^10.16.0",
    "@testcontainers/redis": "^10.16.0",
    "eslint": "^9.16.0",
    "globals": "^15.15.0",
    "node-pg-migrate": "^7.9.1",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "testcontainers": "^10.16.0",
    "vitest": "^2.1.8"
  }
}
